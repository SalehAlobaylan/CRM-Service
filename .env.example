# CRM Service Environment Variables
# Copy this file to .env and customize for your environment

# ===================
# Server Configuration
# ===================
SERVER_PORT=4000
ENVIRONMENT=development  # development | production

# ===================
# Shared Database Configuration (Wahb Platform)
# ===================
# IMPORTANT: CRM and CMS now share the wahb_platform database
# PostgreSQL connection URL format: postgres://user:password@host:port/dbname?sslmode=mode
# Update the host, user, password for your environment
# DATABASE_URL=postgres://postgres:your-password@your-shared-postgres-host:5432/wahb_platform?sslmode=disable

# ===================
# Shared JWT Configuration (Must match IAM signer)
# ===================
# IMPORTANT: This must be identical to the IAM signing secret
JWT_SECRET=123
JWT_ISSUER=iam-authorization-service
JWT_ALLOWED_ISSUERS=iam-authorization-service,cms-service

# ===================
# CORS Configuration
# ===================
# Comma-separated list of allowed origins
# Include Platform Console domains (production + staging + localhost)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005,https://wahb-console.salehspace.dev
